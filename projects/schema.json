{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csc3213-2026-group-b.github.io/public-json-schemas/projects/schema.json",
  "title": "SCS Project Registry Item",
  "description": "Project metadata for the SCS public projects registry.",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "shortDescription",
    "description",
    "projectType",
    "status",
    "categories",
    "people",
    "source",
    "media",
    "dates"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "shortDescription": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "projectType": {
      "enum": [
        "COURSE_PROJECT",
        "RESEARCH_PROJECT",
        "STUDENT_INNOVATION",
        "OPEN_SOURCE",
        "DEPARTMENT_SYSTEM",
        "DATASET",
        "PUBLICATION_ARTIFACT",
        "INDUSTRY_COLLABORATION",
        "FACULTY_COLLABORATION",
        "HACKATHON",
        "OTHER"
      ]
    },
    "status": {
      "enum": ["PLANNED", "ACTIVE", "COMPLETED", "ARCHIVED"]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "academicYear": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        {
          "type": "string",
          "pattern": "^\\d{4}/\\d{4}$"
        }
      ]
    },
    "course": {
      "type": "object",
      "required": ["code", "title"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3}\\d{4}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "batch": {
      "type": "string",
      "minLength": 1
    },
    "groupNumber": {
      "type": "string",
      "minLength": 1
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "student",
              "supervisor",
              "instructor",
              "maintainer",
              "collaborator",
              "contributor"
            ]
          },
          "username": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._]{2,29}$"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "sNumber": {
            "type": "string",
            "pattern": "^S\\d{2}(SP)?\\d{3}$"
          }
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "documentation": {
          "type": "string",
          "format": "uri"
        },
        "demo": {
          "type": "string",
          "format": "uri"
        },
        "dataset": {
          "type": "string",
          "format": "uri"
        },
        "publication": {
          "type": "string",
          "format": "uri"
        },
        "video": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "repositoryName",
            "repositoryOwner",
            "metadataPath"
          ],
          "properties": {
            "kind": {
              "const": "TEMPLATE_INDEX_JSON"
            },
            "repositoryName": {
              "type": "string",
              "minLength": 1
            },
            "repositoryOwner": {
              "type": "string",
              "minLength": 1
            },
            "metadataPath": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "curator"],
          "properties": {
            "kind": {
              "const": "MANUAL"
            },
            "curator": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "repositoryName", "repositoryOwner"],
          "properties": {
            "kind": {
              "const": "GITHUB_REPO"
            },
            "repositoryName": {
              "type": "string",
              "minLength": 1
            },
            "repositoryOwner": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "media": {
      "type": "object",
      "required": ["icon"],
      "properties": {
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "coverImage": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "dates": {
      "type": "object",
      "required": ["lastUpdatedAt"],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date"
        },
        "completedAt": {
          "type": "string",
          "format": "date"
        },
        "lastUpdatedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "projectType": {
            "const": "COURSE_PROJECT"
          }
        },
        "required": ["projectType"]
      },
      "then": {
        "required": ["course"]
      }
    }
  ],
  "additionalProperties": false
}
